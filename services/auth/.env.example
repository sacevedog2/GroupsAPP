SERVICE_NAME=groupsapp-auth
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8081
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
DATABASE_URL=postgresql+asyncpg://groupsapp:groupsapp@localhost:5432/groupsapp_auth
JWT_SECRET_KEY=change-me-in-production-at-least-16
JWT_ISSUER=groupsapp-auth
ACCESS_TOKEN_TTL_SECONDS=3600
PASSWORD_PBKDF2_ITERATIONS=310000
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=groupsapp.events
