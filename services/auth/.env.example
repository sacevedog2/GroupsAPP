SERVICE_NAME=groupsapp-auth
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8081
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
DATABASE_URL=postgresql+asyncpg://<rds_user>:<rds_password>@<rds_endpoint>:5432/groupsapp_auth
JWT_SECRET_KEY=<replace-with-strong-random-secret>
JWT_ISSUER=groupsapp-auth
ACCESS_TOKEN_TTL_SECONDS=3600
PASSWORD_PBKDF2_ITERATIONS=310000
RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@<rabbitmq-service>:5672/
RABBITMQ_EXCHANGE=groupsapp.events
