SERVICE_NAME=groupsapp-notifications
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8083
DATABASE_URL=postgresql+asyncpg://<rds_user>:<rds_password>@<rds_endpoint>:5432/groupsapp_notifications
RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@<rabbitmq-service>:5672/
RABBITMQ_EXCHANGE=groupsapp.events
