SERVICE_NAME=groupsapp-messaging
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8080
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
DATABASE_URL=postgresql+asyncpg://<rds_user>:<rds_password>@<rds_endpoint>:5432/groupsapp_messaging
RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@<rabbitmq-service>:5672/
RABBITMQ_EXCHANGE=groupsapp.events
ATTACHMENT_ROOT=/app/data/attachments
MAX_UPLOAD_MB=50
